---
import BlogArchive from '../../../components/BlogArchive.astro';
import { blogPosts } from '../../../lib/website';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
export const getStaticPaths = (() => Array.from({ length: Math.ceil(blogPosts.length / 12) - 1 }, (_, i) => ({
  params: { page: String(i + 2) },
  props: { currentPage: i + 2 },
}))) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { currentPage } = Astro.props;
---
<BlogArchive currentPage={currentPage} />
