---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';

const options = [
  {
    href: '/v3',
    n: '01',
    style: 'Editorial',
    tag: 'La elegida · blanco y negro alternos',
    desc: 'Serif enorme, filetes de 1px y mucho aire. Las secciones alternan blanco y negro, el panel de ASM2 entra solapando el corte entre ambas, y hay una sección entera dedicada a privacidad con un diagrama del dato que se queda dentro.',
    best: 'Estructura: ASM2 → Mecopia → visión artificial → cinco servicios → privacidad.',
    preview: 'bg-neutral-950 text-white',
    swatches: ['#0A0A0A', '#FFFFFF', '#404040', '#E5E5E5'],
  },
  {
    href: '/v1',
    n: '02',
    style: 'Obsidiana',
    tag: 'Tema oscuro',
    desc: 'Negro absoluto, retícula tenue y focos que siguen al cursor. Los productos se ven en un selector por pestañas: ASM2, Mecopia, visión artificial y extracción documental.',
    best: 'Para público técnico e inversores.',
    preview: 'bg-[#08080A] text-white',
    swatches: ['#08080A', '#18181B', '#71717A', '#FFFFFF'],
  },
  {
    href: '/v2',
    n: '03',
    style: 'Estudio',
    tag: 'Tema claro',
    desc: 'Blanco, retícula de puntos y banda negra de privacidad. Recorre los productos en tres filas alternas: ASM2, Mecopia y visión artificial.',
    best: 'Para vender a empresa mediana y grande.',
    preview: 'bg-white text-neutral-900',
    swatches: ['#FFFFFF', '#F5F5F5', '#A3A3A3', '#171717'],
  },
  {
    href: '/v4',
    n: '04',
    style: 'Espectro',
    tag: 'Nueva · paleta de in2ai.com',
    desc: 'Los colores de la web actual: cian, azul, pizarra y terracota, una letra del logo cada uno, más el azul cielo del hero. El logo se redibuja solo, el titular hueco pisa el panel cielo como en in2ai.com y todo lo que va de cuatro en cuatro lleva los cuatro colores.',
    best: 'Estructura: metodología → ASM2 → Mecopia → a medida → cinco servicios → privacidad.',
    preview: 'bg-brand-sky',
    logo: true,
    swatches: ['#00A9E9', '#3B9ABC', '#6C8C96', '#AA7B69', '#9DBFDA'],
  },
];

const shared = [
  'Mockups de vuestros productos en HTML: panel de ASM2 con carpetas indexadas de OneDrive, Drive, Dropbox y SharePoint; chat que responde citando documento y página; app de Mecopia; e inspección de línea con cajas de detección.',
  'Las cinco áreas de servicio reales: Data Driven, ML/Deep Learning, Visión Artificial, NLP e IA Generativa.',
  'Privacidad como argumento de venta: despliegue on-premise, sin entrenar con vuestros datos y permisos heredados de cada carpeta.',
  'Animaciones sutiles: aparición al hacer scroll, contadores, barras, gráficos que se dibujan, línea de escaneo y foco de cursor. Todo se desactiva con prefers-reduced-motion.',
];
---

<Base
  title="IN2AI — Cuatro propuestas de landing page"
  bodyClass="bg-neutral-50 font-sans text-neutral-700 antialiased"
  progressClass=""
>
  <main class="mx-auto max-w-5xl px-6 py-20">
    <p class="font-mono text-[11px] tracking-[0.22em] text-neutral-400 uppercase">IN2AI · Propuestas</p>
    <h1 class="mt-5 font-display text-4xl font-bold tracking-[-0.02em] text-neutral-900 md:text-5xl">
      Cuatro direcciones para la landing
    </h1>
    <p class="mt-5 max-w-2xl text-neutral-600">
      Mismo mensaje y mismos mockups de producto: tres direcciones en blanco y negro y una
      con la paleta actual de in2ai.com. Abre cada una, baja despacio para ver las animaciones
      y quédate con la que mejor represente al estudio.
    </p>

    <div class="mt-14 space-y-5">
      {options.map((o) => (
        <a
          href={o.href}
          class="group grid gap-7 rounded-2xl border border-black/10 bg-white p-6 transition-all duration-400 hover:-translate-y-1 hover:shadow-xl hover:shadow-neutral-900/5 md:grid-cols-[11rem_1fr]"
        >
          <div class={`grid h-32 place-items-center rounded-xl border border-black/10 ${o.preview}`}>
            {o.logo ? (
              <Logo class="h-8 w-auto" />
            ) : (
              <span class="font-display text-2xl font-bold tracking-tight">IN2AI</span>
            )}
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-3">
              <span class="font-mono text-xs text-neutral-400">{o.n}</span>
              <h2 class="font-display text-xl font-bold text-neutral-900">{o.style}</h2>
              <span class="rounded-full border border-black/10 bg-neutral-50 px-2.5 py-0.5 font-mono text-[10px] tracking-wider text-neutral-500 uppercase">
                {o.tag}
              </span>
            </div>
            <p class="mt-2.5 text-sm leading-relaxed text-neutral-600">{o.desc}</p>
            <p class="mt-2 text-sm font-medium text-neutral-900">{o.best}</p>
            <div class="mt-5 flex items-center justify-between">
              <div class="flex gap-1.5">
                {o.swatches.map((s) => (
                  <span class="h-5 w-5 rounded-full border border-black/10" style={`background:${s}`}></span>
                ))}
              </div>
              <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-neutral-900">
                Ver landing
                <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <section class="mt-16 rounded-2xl border border-black/10 bg-white p-8">
      <h2 class="font-display text-lg font-bold text-neutral-900">Lo que comparten las cuatro</h2>
      <ul class="mt-5 space-y-3">
        {shared.map((s) => (
          <li class="flex gap-3 text-sm leading-relaxed text-neutral-600">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-neutral-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {s}
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>
