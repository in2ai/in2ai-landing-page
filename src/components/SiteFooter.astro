---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Logo from './Logo.astro';
import { company, products, services, sectors } from '../lib/content';
import { getLocale, useTranslations } from '../i18n';
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const a = t.anchors;
const home = getRelativeLocaleUrl(locale, '');
const serviceItems = services.map((s) => ({ ...s, ...t.services.items[s.id] }));
const sectorItems = sectors.map((s) => ({ ...s, ...t.sectors.items[s.id] }));
---
    <footer class="bg-brand-ink">
      <div class="mx-auto max-w-[86rem] px-6 pb-10 md:px-10">
        <div class="grid gap-x-8 gap-y-10 border-t border-white/10 pt-16 pb-16 sm:grid-cols-2 lg:grid-cols-[1.25fr_1fr_1fr_1fr_1.25fr]">
          <div>
            <p class="text-[11px] font-semibold tracking-[0.16em] text-brand-slate uppercase">{t.footer.solutions}</p>
            <div class="mt-4 flex flex-col gap-1.5 text-sm text-brand-mist/70">
              {serviceItems.map((s) => (
                <a href={s.url} class="transition-colors hover:text-white">{s.name}</a>
              ))}
            </div>
          </div>
          <div>
            <p class="text-[11px] font-semibold tracking-[0.16em] text-brand-slate uppercase">{t.footer.sectors}</p>
            <div class="mt-4 flex flex-col gap-1.5 text-sm text-brand-mist/70">
              {sectorItems.map((s) => (
                <a href={s.url} class="transition-colors hover:text-white">{s.name}</a>
              ))}
            </div>
          </div>
          <div>
            <p class="text-[11px] font-semibold tracking-[0.16em] text-brand-slate uppercase">{t.footer.products}</p>
            <div class="mt-4 flex flex-col gap-1.5 text-sm text-brand-mist/70">
              <a href={products.asm2.url} target="_blank" rel="noopener" class="transition-colors hover:text-white">{t.footer.asm2}</a>
              <a href={products.mecopia.url} target="_blank" rel="noopener" class="transition-colors hover:text-white">{t.footer.mecopia}</a>
            </div>
          </div>
          <div>
            <p class="text-[11px] font-semibold tracking-[0.16em] text-brand-slate uppercase">{t.footer.company}</p>
            <div class="mt-4 flex flex-col gap-1.5 text-sm text-brand-mist/70">
              {t.pages.map((p) => (
                <a href={p.href} hreflang={p.hreflang} class="transition-colors hover:text-white">{p.label}</a>
              ))}
              <a href={`${home}#${a.contact}`} class="transition-colors hover:text-white">{t.header.contact}</a>
              <a href={company.linkedin} target="_blank" rel="noopener" class="transition-colors hover:text-white">LinkedIn</a>
            </div>
          </div>
          <div>
            <p class="text-[11px] font-semibold tracking-[0.16em] text-brand-slate uppercase">{t.footer.offices}</p>
            <div class="mt-4 space-y-5 text-sm leading-relaxed text-brand-mist/70">
              {t.offices.map((o) => (
                <address class="not-italic">
                  <span class="font-medium text-white">{o.name}</span>
                  {o.lines.map((l) => (
                    <>
                      <br />
                      {l}
                    </>
                  ))}
                </address>
              ))}
              <a href={`mailto:${company.email}`} class="inline-block transition-colors hover:text-white">{company.email}</a>
            </div>
          </div>
        </div>

        <Logo class="h-auto w-full" draw weight={10} />

        <div class="mt-12 flex flex-col justify-between gap-3 border-t border-white/10 pt-6 text-xs text-brand-slate sm:flex-row">
          <p>© 2026 {company.legalName}</p>
          <div class="flex flex-wrap gap-x-6 gap-y-2">
            {Object.values(t.legal).map((l) => (
              <a href={l.href} hreflang={l.hreflang} class="transition-colors hover:text-white">{l.label}</a>
            ))}
          </div>
        </div>
      </div>
    </footer>
