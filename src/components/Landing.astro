---
/**
 * La landing completa. La renderizan src/pages/index.astro (español) y
 * src/pages/en/index.astro (inglés); el idioma sale de la URL.
 */
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import ContactForm from './ContactForm.astro';
import CompanyContent from './CompanyContent.astro';
import SiteFooter from './SiteFooter.astro';
import Rich from './Rich.astro';
import Console from './mock/Console.astro';
import ChatPanel from './mock/ChatPanel.astro';
import VisionPanel from './mock/VisionPanel.astro';
import DocPanel from './mock/DocPanel.astro';
import PhoneMock from './mock/PhoneMock.astro';
import { company, products, services, sectors, stats, offer } from '../lib/content';
import { getLocale, useTranslations } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const a = t.anchors;

// los datos fijos (iconos, cifras) de content.ts con el texto del idioma
const serviceItems = services.map((s) => ({ ...s, ...t.services.items[s.id] }));
const sectorItems = sectors.map((s) => ({ ...s, ...t.sectors.items[s.id] }));
const offerItems = offer.map((o) => ({ ...o, ...t.offer.items[o.id] }));
const statItems = stats.map((s) => ({ ...s, source: 'source' in s ? s.source : undefined, label: t.stats[s.id] }));

// La paleta de in2ai.com, pero en combinaciones cerradas en vez de todos los colores a la vez.
// Las secciones alternan claro y oscuro, y cada una usa solo la suya:
//   claro  · blanco o niebla, tinta y azul
//   oscuro · tinta, blanco y cian (el cielo como texto secundario)
//   cielo  · cielo, tinta y blanco: solo en el hero y en la declaración final
// La terracota queda para Mecopia, y el logo es el único sitio con los cuatro colores juntos.

const thin = '--outline-w:1.5px';
const cyan = '--outline-c:var(--color-brand-cyan);--outline-w:1.5px';

const arrow = 'M5 12h14m-6-6 6 6-6 6';
const external = 'M7 17 17 7M9 7h8v8';
const check = 'm5 13 4 4L19 7';
const lock = 'M6 10h12v10H6zM8.5 10V7.5a3.5 3.5 0 0 1 7 0V10';
---

<Base
  title={t.meta.title}
  description={t.meta.description}
  bodyClass="bg-white font-sans text-brand-ink antialiased selection:bg-brand-cyan selection:text-brand-ink"
  progressClass="bg-brand-cyan"
  themeColor="#ffffff"
>
  <!-- clip y no hidden: hidden convierte el div en contenedor de scroll y el header deja de ser sticky -->
  <div class="overflow-x-clip">
    <!-- ───────────────────────────── header ───────────────────────────── -->
    <SiteHeader />

    <!-- ───────────────────────────── hero (blanco + cielo) ───────────── -->
    <section class="relative overflow-hidden">
      <!-- el panel cielo del hero de in2ai.com; el titular lo pisa igual que allí -->
      <div class="absolute inset-y-0 right-0 left-[40%] hidden bg-brand-sky lg:block xl:left-[36%]" aria-hidden="true">
        <svg
          viewBox="184 0 122 92"
          class="absolute bottom-[7%] left-[6%] w-[26%]"
          fill="none"
          stroke="white"
          stroke-opacity="0.7"
          stroke-width="1.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M196,85.5 L229,6 L262,85.5" pathLength="1" data-draw style="--len:1;--d:600ms" />
          <path d="M293.5,6 V85.5" pathLength="1" data-draw style="--len:1;--d:900ms" />
        </svg>
      </div>

      <div
        class="relative mx-auto grid max-w-[86rem] gap-14 px-6 pt-14 md:px-10 lg:min-h-[calc(100svh-4.5rem)] lg:grid-cols-[1.08fr_1fr] lg:items-center lg:gap-10 lg:py-16"
      >
        <div class="relative z-10">
          <p class="flex items-center gap-3 text-[11px] font-semibold tracking-[0.2em] text-brand-blue-deep uppercase" data-reveal="fade">
            <span class="h-px w-8 bg-brand-blue" aria-hidden="true"></span>
            {t.hero.eyebrow}
          </p>

          <h1
            class="mt-8 font-display text-[clamp(3rem,6.8vw,6.6rem)] leading-[0.95] font-bold tracking-[-0.045em] text-brand-ink"
            data-reveal
          >
            <Rich text={t.hero.title} />
          </h1>

          <p class="mt-9 max-w-[25rem] text-lg leading-relaxed text-brand-ink/75" data-reveal style="--d:120ms">
            {t.hero.text}
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4" data-reveal style="--d:220ms">
            <a
              href={`#${a.contact}`}
              class="group inline-flex items-center gap-2.5 rounded-full bg-brand-blue-deep px-6 py-3.5 text-sm font-semibold text-white transition-colors duration-300 hover:bg-brand-ink"
            >
              {t.hero.cta}
              <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d={arrow} stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <a href={`#${a.services}`} class="link-sweep text-sm font-semibold text-brand-ink">{t.hero.secondary}</a>
          </div>
          <p class="mt-5 text-xs text-brand-slate-deep" data-reveal style="--d:280ms">{t.hero.note}</p>
        </div>

        <!-- en móvil el panel cielo pasa a ser el fondo del mockup -->
        <div class="relative -mx-6 bg-brand-sky px-6 pt-14 pb-20 md:-mx-10 md:px-10 lg:mx-0 lg:bg-transparent lg:p-0">
          <div class="relative mx-auto max-w-[31rem] lg:mr-0" data-reveal="scale" style="--d:200ms">
            <ChatPanel variant="brand" class="float" />

            <div
              class="float-slow absolute -bottom-14 -left-2 flex items-center gap-3 rounded-xl bg-brand-ink px-4 py-3 shadow-xl shadow-brand-ink/25 sm:-left-12"
            >
              <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-cyan/15 text-brand-cyan">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
                  <path d={lock} />
                </svg>
              </span>
              <div>
                <p class="text-[12px] font-semibold text-white">{t.hero.badge.title}</p>
                <p class="text-[11px] text-brand-sky">{t.hero.badge.text}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────────────────────────── metodología (tinta) ─────────────── -->
    <section id={a.method} class="scroll-mt-16 bg-brand-ink">
      <div class="mx-auto max-w-[86rem] px-6 py-24 md:px-10 md:py-32">
        <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
          <div data-reveal="left">
            <p class="text-[11px] font-semibold tracking-[0.2em] text-brand-sky uppercase">{t.method.eyebrow}</p>
            <h2 class="mt-6 font-display text-[clamp(2.4rem,5vw,4.2rem)] leading-[0.98] font-bold tracking-[-0.04em] text-white">
              <Rich text={t.method.title} outline={cyan} />
            </h2>
            <p class="mt-7 max-w-md text-lg leading-relaxed text-brand-mist/70">{t.method.text}</p>
          </div>

          <ol class="grid gap-x-10 gap-y-12 self-center sm:grid-cols-2">
            {t.method.steps.map((m, i) => (
              <li data-reveal style={`--d:${i * 110}ms`}>
                <div class="h-1 w-full rounded-full bg-white/10">
                  <div class="h-full rounded-full bg-brand-cyan" data-grow style={`--d:${300 + i * 150}ms`}></div>
                </div>
                <p class="mt-6 font-mono text-[11px] text-brand-cyan">{String(i + 1).padStart(2, '0')}</p>
                <h3 class="mt-2 font-display text-2xl font-bold tracking-[-0.02em] text-white">{m.t}</h3>
                <p class="mt-3 leading-relaxed text-brand-mist/65">{m.d}</p>
              </li>
            ))}
          </ol>
        </div>

        <!-- las cifras de in2ai.com: arriba la IA, abajo la digitalización -->
        <div class="mt-24 border-t border-white/10 pt-14">
          <p class="text-[11px] font-semibold tracking-[0.2em] text-brand-sky uppercase" data-reveal="fade">{t.method.statsEyebrow}</p>
          <dl class="mt-12 grid grid-cols-2 gap-y-12 md:grid-cols-3 md:gap-y-16">
            {statItems.map((n, i) => (
              <div
                class="pr-6 md:border-l md:border-white/10 md:pl-8 md:nth-[3n+1]:border-l-0 md:nth-[3n+1]:pl-0"
                data-reveal="fade"
                style={`--d:${(i % 3) * 110}ms`}
              >
                <dt class="font-display text-[clamp(2.6rem,5vw,4.4rem)] leading-none font-bold tracking-[-0.04em] text-white">
                  <span data-count={n.value} data-prefix={n.prefix} data-suffix={n.suffix}>0</span>
                </dt>
                <dd class="mt-4 max-w-[16rem] text-sm text-brand-sky/80">{n.label}</dd>
                {n.source && <dd class="mt-2 font-mono text-[10px] tracking-[0.16em] text-brand-slate uppercase">{n.source}</dd>}
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- ───────────────────────────── servicios (blanco) ─────────────── -->
    <section id={a.services} class="scroll-mt-16 bg-white">
      <div class="mx-auto max-w-[86rem] px-6 py-24 md:px-10 md:py-32">
        <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between" data-reveal>
          <h2 class="font-display text-[clamp(2.4rem,5.5vw,4.4rem)] leading-[0.98] font-bold tracking-[-0.04em] text-brand-ink">
            <Rich text={t.services.title} outline={thin} />
          </h2>
          <p class="max-w-sm leading-relaxed text-brand-ink/70">{t.services.text}</p>
        </div>

        <!-- cuatro fichas claras en azul; la quinta, IA generativa, se invierte a tinta y cian -->
        <div class="mt-16 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {serviceItems.map((s, i) => {
            const dark = i === 4;
            return (
              <div class={`h-full ${dark ? 'md:col-span-2' : ''}`} data-reveal style={`--d:${(i % 3) * 90}ms`}>
                <article
                  class={`group relative flex h-full flex-col overflow-hidden rounded-2xl border p-7 transition-all duration-500 hover:-translate-y-1 md:p-8 ${
                    dark
                      ? 'border-brand-ink bg-brand-ink hover:shadow-xl hover:shadow-brand-ink/25'
                      : 'border-brand-blue/15 bg-white hover:border-brand-blue/30 hover:shadow-xl hover:shadow-brand-blue/10'
                  }`}
                >
                  <div class="flex items-start justify-between">
                    <span
                      class={`grid h-12 w-12 place-items-center rounded-xl ${
                        dark ? 'bg-brand-cyan text-brand-ink' : 'border border-brand-blue/15 bg-brand-mist text-brand-blue-deep'
                      }`}
                    >
                      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d={s.icon} />
                      </svg>
                    </span>
                    <span class={`font-mono text-xs ${dark ? 'text-brand-sky' : 'text-brand-slate-deep'}`}>{s.roman}</span>
                  </div>
                  <h3 class={`mt-8 font-display text-2xl leading-tight font-bold tracking-[-0.02em] ${dark ? 'text-white' : 'text-brand-ink'}`}>
                    {s.name}
                  </h3>
                  <p class={`mt-3 max-w-xl leading-relaxed ${dark ? 'text-brand-mist/70' : 'text-brand-ink/70'}`}>{s.text}</p>
                  <div class="mt-auto flex flex-wrap gap-1.5 pt-7">
                    {s.tags.map((tag) => (
                      <span
                        class={`rounded-full border px-3 py-1 text-[11px] font-medium ${
                          dark ? 'border-brand-sky/20 text-brand-sky' : 'border-brand-blue/15 bg-brand-mist text-brand-slate-deep'
                        }`}
                      >
                        {tag}
                      </span>
                    ))}
                  </div>
                  <!-- el enlace cubre toda la ficha con su ::after -->
                  <a
                    href={s.url}
                    class={`mt-7 inline-flex items-center gap-2 self-start text-sm font-semibold after:absolute after:inset-0 ${
                      dark ? 'text-brand-cyan' : 'text-brand-blue-deep'
                    }`}
                  >
                    {t.services.more}
                    <span class="sr-only">{` ${t.services.moreAbout} ${s.name}`}</span>
                    <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d={arrow} stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                  <span
                    class={`absolute inset-x-0 bottom-0 h-1 origin-left scale-x-0 transition-transform duration-500 group-hover:scale-x-100 ${
                      dark ? 'bg-brand-cyan' : 'bg-brand-blue'
                    }`}
                    aria-hidden="true"
                  ></span>
                </article>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ───────────────────────────── qué ofrecemos (tinta) ──────────── -->
    <section id={a.offer} class="scroll-mt-16 bg-brand-ink">
      <div class="mx-auto max-w-[86rem] px-6 py-24 md:px-10 md:py-32">
        <div class="grid gap-8 md:grid-cols-[1.1fr_1fr] md:items-end" data-reveal>
          <div>
            <p class="text-[11px] font-semibold tracking-[0.2em] text-brand-sky uppercase">{t.offer.eyebrow}</p>
            <h2 class="mt-6 font-display text-[clamp(2.4rem,5.5vw,4.4rem)] leading-[0.98] font-bold tracking-[-0.04em] text-white">
              <Rich text={t.offer.title} outline={cyan} />
            </h2>
          </div>
          <p class="max-w-md text-lg leading-relaxed text-brand-mist/70">{t.offer.text}</p>
        </div>

        <ul class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {offerItems.map((o, i) => (
            <li
              class="flex flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-7 transition-colors duration-500 hover:border-brand-cyan/40"
              data-reveal
              style={`--d:${i * 110}ms`}
            >
              <div class="flex items-start justify-between">
                <span class="grid h-12 w-12 place-items-center rounded-xl bg-brand-cyan/15 text-brand-cyan">
                  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={o.icon} />
                  </svg>
                </span>
                <span class="font-mono text-[11px] text-brand-cyan">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="mt-8 font-display text-2xl font-bold tracking-[-0.02em] text-white">{o.t}</h3>
              <p class="mt-3 leading-relaxed text-brand-mist/65">{o.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ───────────────────────────── productos (niebla) ──────────────── -->
    <section id={a.products} class="scroll-mt-16 bg-brand-mist">
      <div class="mx-auto max-w-[86rem] px-6 py-24 md:px-10 md:py-32">
        <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between" data-reveal>
          <h2 class="font-display text-[clamp(2.4rem,5.5vw,4.4rem)] leading-[0.98] font-bold tracking-[-0.04em] text-brand-ink">
            <Rich text={t.products.title} outline={thin} />
          </h2>
          <p class="max-w-sm leading-relaxed text-brand-ink/70">{t.products.text}</p>
        </div>

        <!-- 01 · ASM2: azul -->
        <div class="mt-16 grid gap-10 md:grid-cols-2 md:gap-16">
          <div data-reveal="left">
            <span class="inline-flex items-center gap-2 rounded-full border border-brand-blue/20 bg-white px-3 py-1 text-[11px] font-semibold text-brand-blue-deep">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-blue"></span>
              01 · {t.products.kicker}
            </span>
            <h3 class="mt-6 font-display text-[clamp(2.4rem,5vw,3.8rem)] leading-none font-bold tracking-[-0.04em] text-brand-ink">
              {products.asm2.name}
            </h3>
            <p class="mt-4 font-display text-xl font-medium tracking-[-0.01em] text-brand-blue-deep">{t.products.asm2.claim}</p>
            <p class="mt-6 max-w-lg leading-relaxed text-brand-ink/75">{t.products.asm2.text}</p>
          </div>

          <div class="md:pt-14" data-reveal="right" style="--d:120ms">
            <ul>
              {t.products.asm2.points.map((p) => (
                <li class="flex gap-3.5 border-b border-brand-blue/15 py-4 text-brand-ink/85 first:pt-0">
                  <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path d={check} stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {p}
                </li>
              ))}
            </ul>
            <a
              href={products.asm2.url}
              target="_blank"
              rel="noopener"
              class="group mt-8 inline-flex items-center gap-2 text-sm font-semibold text-brand-blue-deep"
            >
              <span class="link-sweep">{products.asm2.host}</span>
              <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d={external} stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </div>

        <div class="mt-14" data-reveal="scale" style="--d:160ms">
          <Console variant="brand" />
        </div>

        <!-- 02 · Mecopia: terracota -->
        <div class="mt-28 grid items-center gap-12 md:grid-cols-2 md:gap-16">
          <div class="relative order-2 grid place-items-center overflow-hidden rounded-3xl bg-brand-clay/15 px-6 py-16 md:order-1" data-reveal="left">
            <div class="pointer-events-none absolute -top-20 -right-16 h-72 w-72 rounded-full bg-brand-sky/60 blur-3xl" aria-hidden="true"></div>
            <div class="pointer-events-none absolute -bottom-24 -left-16 h-72 w-72 rounded-full bg-brand-clay/35 blur-3xl" aria-hidden="true"></div>
            <PhoneMock variant="brand" class="float relative" />
          </div>

          <div class="order-1 md:order-2" data-reveal="right">
            <span class="inline-flex items-center gap-2 rounded-full border border-brand-clay/30 bg-white px-3 py-1 text-[11px] font-semibold text-brand-clay-deep">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-clay"></span>
              02 · {t.products.kicker}
            </span>
            <h3 class="mt-6 font-display text-[clamp(2.4rem,5vw,3.8rem)] leading-none font-bold tracking-[-0.04em] text-brand-ink">
              {products.mecopia.name}
            </h3>
            <p class="mt-4 font-display text-xl font-medium tracking-[-0.01em] text-brand-clay-deep">{t.products.mecopia.claim}</p>
            <p class="mt-6 max-w-lg leading-relaxed text-brand-ink/75">{t.products.mecopia.text}</p>

            <ul class="mt-8">
              {t.products.mecopia.points.map((p) => (
                <li class="flex gap-3.5 border-b border-brand-blue/15 py-3.5 text-brand-ink/85 last:border-0">
                  <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-clay" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path d={check} stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {p}
                </li>
              ))}
            </ul>

            <a
              href={products.mecopia.url}
              target="_blank"
              rel="noopener"
              class="group mt-7 inline-flex items-center gap-2 text-sm font-semibold text-brand-clay-deep"
            >
              <span class="link-sweep">{products.mecopia.host}</span>
              <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d={external} stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────────────────────────── a medida (tinta) ────────────────── -->
    <section class="bg-brand-ink">
      <div class="marquee border-b border-white/10 py-4" style="--speed:60s" aria-hidden="true">
        <div class="marquee-track">
          {[0, 1].map(() => (
            <div class="flex shrink-0">
              {t.keywords.map((w) => (
                <span class="flex items-center gap-6 px-6 font-mono text-[10px] tracking-[0.3em] whitespace-nowrap text-brand-slate uppercase">
                  {w}
                  <span class="h-1 w-1 rounded-full bg-brand-cyan"></span>
                </span>
              ))}
            </div>
          ))}
        </div>
      </div>

      <div class="mx-auto max-w-[86rem] px-6 py-24 md:px-10 md:py-32">
        <div class="grid gap-8 md:grid-cols-[1.1fr_1fr] md:items-end" data-reveal>
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-brand-sky/20 px-3 py-1 text-[11px] font-semibold text-brand-sky">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-cyan"></span>
              {t.custom.badge}
            </span>
            <h2 class="mt-6 font-display text-[clamp(2.4rem,5.5vw,4.4rem)] leading-[0.98] font-bold tracking-[-0.04em] text-white">
              <Rich text={t.custom.title} outline={cyan} />
            </h2>
          </div>
          <p class="max-w-md text-lg leading-relaxed text-brand-mist/70">{t.custom.text}</p>
        </div>

        <div class="mt-16 grid gap-12 lg:grid-cols-2 lg:gap-8">
          <figure data-reveal="left">
            <VisionPanel variant="brand-dark" />
            <figcaption class="mt-5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="h-2 w-2 rounded-full bg-brand-cyan"></span>
              <span class="font-display text-lg font-semibold text-white">{t.custom.vision.title}</span>
              <span class="text-sm text-brand-slate">{t.custom.vision.caption}</span>
            </figcaption>
          </figure>
          <figure data-reveal="right" style="--d:140ms">
            <DocPanel variant="brand-dark" />
            <figcaption class="mt-5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="h-2 w-2 rounded-full bg-brand-cyan"></span>
              <span class="font-display text-lg font-semibold text-white">{t.custom.nlp.title}</span>
              <span class="text-sm text-brand-slate">{t.custom.nlp.caption}</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ───────────────────────────── sectores (blanco) ──────────────── -->
    <section id={a.sectors} class="scroll-mt-16 bg-white">
      <div class="mx-auto max-w-[86rem] px-6 py-24 md:px-10 md:py-32">
        <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between" data-reveal>
          <h2 class="font-display text-[clamp(2.4rem,5.5vw,4.4rem)] leading-[0.98] font-bold tracking-[-0.04em] text-brand-ink">
            <Rich text={t.sectors.title} outline={thin} />
          </h2>
          <p class="max-w-sm leading-relaxed text-brand-ink/70">{t.sectors.text}</p>
        </div>

        <ul class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {sectorItems.map((s, i) => (
            <li data-reveal style={`--d:${(i % 3) * 90}ms`}>
              <a
                href={s.url}
                class="group flex items-center gap-5 rounded-2xl border border-brand-blue/15 bg-white p-5 transition-all duration-500 hover:-translate-y-0.5 hover:border-brand-blue/30 hover:shadow-xl hover:shadow-brand-blue/10 md:p-6"
              >
                <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl border border-brand-blue/15 bg-brand-mist text-brand-blue-deep transition-colors duration-500 group-hover:border-brand-blue-deep group-hover:bg-brand-blue-deep group-hover:text-white">
                  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={s.icon} />
                  </svg>
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block font-mono text-[11px] text-brand-slate-deep">{String(i + 1).padStart(2, '0')}</span>
                  <span class="mt-0.5 block font-display text-xl font-bold tracking-[-0.01em] text-brand-ink">{s.name}</span>
                </span>
                <svg class="h-5 w-5 shrink-0 text-brand-blue transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d={arrow} stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ───────────────────────────── privacidad (tinta) ─────────────── -->
    <section id={a.privacy} class="scroll-mt-16 bg-brand-ink">
      <div class="mx-auto max-w-[86rem] px-6 py-24 md:px-10 md:py-32">
        <div class="grid gap-16 lg:grid-cols-2 lg:gap-20">
          <div data-reveal="left">
            <p class="text-[11px] font-semibold tracking-[0.2em] text-brand-sky uppercase">{t.privacy.eyebrow}</p>
            <h2 class="mt-6 font-display text-[clamp(2.4rem,5.5vw,4.4rem)] leading-[0.98] font-bold tracking-[-0.04em] text-white">
              <Rich text={t.privacy.title} outline={cyan} />
            </h2>
            <p class="mt-8 max-w-md text-lg leading-relaxed text-brand-mist/70">{t.privacy.text}</p>

            <!-- diagrama: el dato se queda dentro -->
            <div class="mt-12 rounded-2xl border border-white/10 bg-white/[0.03] p-6" data-reveal="fade" style="--d:200ms">
              <div class="flex items-center justify-between">
                <p class="text-[11px] font-semibold tracking-[0.16em] text-brand-sky uppercase">{t.privacy.network}</p>
                <svg class="h-4 w-4 text-brand-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
                  <path d={lock} />
                </svg>
              </div>
              <ol class="relative mt-5 grid grid-cols-2 gap-2 sm:grid-cols-4">
                <span class="absolute top-1/2 right-6 left-6 hidden h-px bg-brand-cyan/30 sm:block" aria-hidden="true"></span>
                {t.privacy.flow.map((b) => (
                  <li class="relative flex items-center gap-2 rounded-lg border border-white/10 bg-brand-ink px-3 py-2.5 text-[12px] font-medium text-white">
                    <span class="h-2 w-2 shrink-0 rounded-full bg-brand-cyan"></span>
                    {b}
                  </li>
                ))}
              </ol>
              <div class="mt-5 flex items-center gap-3 border-t border-white/10 pt-4 text-[12px]">
                <span class="text-brand-slate line-through decoration-brand-sky/60 decoration-2">{t.privacy.internet}</span>
                <span class="rounded-full bg-brand-cyan/15 px-2.5 py-0.5 text-[11px] font-semibold text-brand-cyan">{t.privacy.notNeeded}</span>
              </div>
            </div>
          </div>

          <ol class="self-center border-b border-white/10">
            {t.privacy.items.map((p, i) => (
              <li class="grid grid-cols-[2.5rem_1fr] border-t border-white/10 py-7" data-reveal="right" style={`--d:${i * 110}ms`}>
                <span class="pt-1.5 font-mono text-[11px] text-brand-cyan">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="font-display text-xl font-bold tracking-[-0.01em] text-white">{p.t}</h3>
                  <p class="mt-2 leading-relaxed text-brand-mist/65">{p.d}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <CompanyContent />

    <!-- ───────────────────────────── declaración (cielo) ────────────── -->
    <section class="relative overflow-hidden bg-brand-sky">
      <!-- el mismo ΛI en línea fina que el hero, para cerrar el recorrido -->
      <svg
        viewBox="184 0 122 92"
        class="pointer-events-none absolute right-[5%] bottom-0 hidden w-[15%] max-w-[15rem] xl:block"
        fill="none"
        stroke="white"
        stroke-opacity="0.55"
        stroke-width="1"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M196,85.5 L229,6 L262,85.5" pathLength="1" data-draw style="--len:1;--d:300ms" />
        <path d="M293.5,6 V85.5" pathLength="1" data-draw style="--len:1;--d:600ms" />
      </svg>

      <div class="relative mx-auto max-w-[86rem] px-6 py-24 md:px-10 md:py-32">
        <div class="mx-auto max-w-4xl text-center" data-reveal>
          <p class="flex items-center justify-center gap-3 text-[11px] font-semibold tracking-[0.2em] text-brand-ink/75 uppercase">
            <span class="h-px w-8 bg-white" aria-hidden="true"></span>
            {t.statement.eyebrow}
            <span class="h-px w-8 bg-white" aria-hidden="true"></span>
          </p>
          <p class="mt-8 font-display text-[clamp(1.7rem,3.8vw,2.9rem)] leading-[1.18] font-medium tracking-[-0.025em] text-brand-ink">
            {t.statement.before}<mark class="rounded bg-white/60 px-1 text-brand-ink">{t.statement.mark}</mark>{t.statement.after}
          </p>
        </div>
      </div>
    </section>

    <!-- ───────────────────────────── contacto (tinta) ───────────────── -->
    <section id={a.contact} class="scroll-mt-16 bg-brand-ink">
      <div class="mx-auto max-w-[86rem] px-6 py-24 md:px-10 md:py-32">
        <div class="grid gap-16 lg:grid-cols-[1.15fr_1fr] lg:gap-24">
          <div data-reveal="left">
            <h2 class="font-display text-[clamp(2.8rem,7vw,6rem)] leading-[0.95] font-bold tracking-[-0.045em] text-white">
              <Rich text={t.contact.title} outline="--outline-c:var(--color-brand-cyan)" />
            </h2>
            <p class="mt-8 max-w-md text-lg leading-relaxed text-brand-mist/70">{t.contact.text}</p>
            <a href={`mailto:${company.email}`} class="link-sweep mt-10 inline-block font-display text-xl font-semibold text-brand-cyan">
              {company.email}
            </a>
          </div>

          <ContactForm />
        </div>
      </div>
    </section>

    <!-- ───────────────────────────── footer ─────────────────────────── -->
    <SiteFooter />
  </div>
</Base>
