---
import { tone, type Tone } from '../../lib/tone';

interface Props {
  variant?: Tone;
  class?: string;
}

const { variant = 'light', class: cls = '' } = Astro.props;
const c = tone(variant);

const tasks = [
  { t: 'Data Engineer · Remoto', s: 'encaje 92% · nueva hoy', v: '48 k€' },
  { t: 'Factura de la luz', s: 'potencia sobredimensionada', v: '−24,80 €' },
  { t: 'Seguro de hogar', s: '3 alternativas más baratas', v: '−118 €' },
];
---

<div
  class={`w-[15.5rem] shrink-0 rounded-[2rem] border-[6px] p-1.5 ${variant === 'dark' ? 'border-white/12 bg-black' : 'border-neutral-900 bg-neutral-900'} ${c.shadow} ${cls}`}
>
  <div class={`relative overflow-hidden rounded-[1.6rem] ${c.panel}`}>
    <!-- notch -->
    <div class="flex justify-center pt-2 pb-1">
      <span class={`h-1 w-12 rounded-full ${c.dot}`}></span>
    </div>

    <div class={`flex items-center justify-between border-b px-4 pb-2.5 ${c.rule}`}>
      <div>
        <p class={`font-display text-[12px] font-bold ${c.head}`}>Mecopia</p>
        <p class={`text-[9px] ${c.muted}`}>Tu gemelo digital</p>
      </div>
      <span class={`grid h-6 w-6 place-items-center rounded-full text-[8px] font-semibold ${c.raised} ${c.body}`}>MM</span>
    </div>

    <div class="p-3.5">
      <div class={`rounded-xl border p-3 ${c.rule} ${c.sub}`}>
        <p class={`text-[9px] tracking-wide uppercase ${c.muted}`}>Ahorro detectado / mes</p>
        <p class={`mt-1 font-display text-2xl font-semibold ${c.head}`}>
          <span data-count="42.8" data-decimals="2" data-suffix=" €">0</span>
        </p>
        <div class={`mt-2 h-1 overflow-hidden rounded-full ${c.track}`}>
          <div class={`h-full rounded-full ${c.fill}`} data-bar style="--w:71%"></div>
        </div>
        <p class={`mt-1.5 text-[9px] ${c.muted}`}>en 3 de tus 7 gastos fijos</p>
      </div>

      <p class={`mt-4 text-[9px] tracking-widest uppercase ${c.muted}`}>Tu gemelo ha encontrado</p>
      <div class="mt-2 space-y-1.5">
        {tasks.map((a, i) => (
          <div
            class={`flex items-center justify-between rounded-lg border px-2.5 py-2 ${c.rule}`}
            data-reveal="fade"
            style={`--d:${200 + i * 140}ms`}
          >
            <div class="min-w-0">
              <p class={`truncate text-[10px] font-medium ${c.head}`}>{a.t}</p>
              <p class={`truncate text-[9px] ${c.muted}`}>{a.s}</p>
            </div>
            <p class={`ml-2 font-mono text-[10px] whitespace-nowrap ${c.body}`}>{a.v}</p>
          </div>
        ))}
      </div>

      <div class={`mt-3 flex items-center justify-center gap-1.5 rounded-lg py-2 ${c.fill}`}>
        <span class={`text-[10px] font-semibold ${variant === 'dark' ? 'text-black' : 'text-white'}`}>
          Ver los 3 siguientes pasos
        </span>
      </div>

      <p class={`mt-2.5 text-center text-[8px] ${c.muted}`}>Tus datos son tuyos · bórralos cuando quieras</p>
    </div>

    <!-- barra inferior -->
    <div class={`flex items-center justify-around border-t px-4 py-2.5 ${c.rule} ${c.sub}`}>
      {[
        'M4 13h6V4H4v9Zm10 7h6v-9h-6v9ZM4 20h6v-5H4v5Z',
        'M4 7h16v13H4zM9 7V4h6v3',
        'M12 3a3 3 0 0 1 3 3v1h1a3 3 0 0 1 3 3v7H5v-7a3 3 0 0 1 3-3h1V6a3 3 0 0 1 3-3Z',
      ].map((d, i) => (
        <svg
          class={`h-3.5 w-3.5 ${i === 0 ? c.head : c.dot}`}
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d={d} />
        </svg>
      ))}
    </div>
  </div>
</div>
