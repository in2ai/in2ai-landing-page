---
import { tone, type Tone } from '../../lib/tone';
import WindowFrame from './WindowFrame.astro';

interface Props {
  variant?: Tone;
  class?: string;
}

const { variant = 'dark', class: cls = '' } = Astro.props;
const c = tone(variant);

const nav = [
  { label: 'Resumen', icon: 'M4 13h6V4H4v9Zm10 7h6v-9h-6v9ZM4 20h6v-5H4v5Zm10-11h6V4h-6v5Z', active: true },
  { label: 'Fuentes', icon: 'M3 7h6l2 2h10v9a2 2 0 0 1-2 2H3V7Z' },
  { label: 'Índice', icon: 'M4 6c0-1.1 3.6-2 8-2s8 .9 8 2-3.6 2-8 2-8-.9-8-2Zm0 6c0 1.1 3.6 2 8 2s8-.9 8-2M4 6v12c0 1.1 3.6 2 8 2s8-.9 8-2V6' },
  { label: 'Conversaciones', icon: 'M4 5h16v10H9l-5 4V5Z' },
  { label: 'Permisos', icon: 'M12 3l8 3v6c0 5-3.4 8-8 9-4.6-1-8-4-8-9V6l8-3Z' },
];

const kpis = [
  { label: 'Documentos indexados', value: '48312', decimals: '0', suffix: '', delta: '4 carpetas' },
  { label: 'Preguntas / mes', value: '9480', decimals: '0', suffix: '', delta: '+34%' },
  { label: 'Respuesta media', value: '1.4', decimals: '1', suffix: ' s', delta: 'con citas' },
];

// carpetas indexadas: 8.412 + 1.204 + 23.180 + 15.516 = 48.312
const folders = [
  { src: 'OneDrive', path: '/Calidad/Procedimientos', docs: '8.412', state: 'OK', bar: 100 },
  { src: 'Google Drive', path: '/RRHH/Convenios', docs: '1.204', state: 'OK', bar: 100 },
  { src: 'Dropbox', path: '/Proyectos/2026', docs: '23.180', state: 'SYNC', bar: 68 },
  { src: 'SharePoint', path: '/Legal/Contratos', docs: '15.516', state: 'OK', bar: 100 },
];

// serie de preguntas de los empleados
const series = [18, 26, 24, 38, 35, 49, 57, 52, 68, 76, 72, 90];
const W = 560;
const H = 170;
const pts = series.map((v, i) => [(i * W) / (series.length - 1), H - (v / 100) * (H - 22)]);
const line = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const area = `${line} L${W},${H} L0,${H} Z`;
const gradId = `area-${variant}`;
---

<WindowFrame variant={variant} label="asm2.tu-empresa.local" class={cls}>
  <div class={`grid ${c.panel} lg:grid-cols-[13rem_1fr]`}>
    <!-- sidebar -->
    <aside class={`hidden border-r p-4 lg:flex lg:flex-col ${c.rule} ${c.sub}`}>
      <div class="flex items-center gap-2">
        <span class={`grid h-6 w-6 place-items-center rounded-md ${c.fill}`}>
          <span class={`font-display text-[10px] font-bold ${variant === 'dark' ? 'text-black' : 'text-white'}`}>A2</span>
        </span>
        <span class={`font-display text-xs font-semibold ${c.head}`}>ASM2</span>
      </div>

      <nav class="mt-6 space-y-0.5">
        {nav.map((n) => (
          <div
            class={`flex items-center gap-2.5 rounded-md px-2.5 py-2 text-[11px] ${
              n.active ? `${c.raised} ${c.head} font-medium` : c.muted
            }`}
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d={n.icon} />
            </svg>
            {n.label}
          </div>
        ))}
      </nav>

      <div class={`mt-auto rounded-lg border p-3 ${c.rule}`}>
        <p class={`flex items-center gap-1.5 text-[10px] ${c.body}`}>
          <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="4" y="10" width="16" height="10" rx="2" />
            <path d="M8 10V7a4 4 0 0 1 8 0v3" />
          </svg>
          Servidor propio
        </p>
        <p class={`mt-1.5 font-mono text-[9px] leading-relaxed ${c.muted}`}>
          Nada sale de tu red.<br />v2.4 · rack interno
        </p>
      </div>
    </aside>

    <!-- main -->
    <div>
      <div class={`flex items-center justify-between gap-4 border-b px-5 py-3.5 ${c.rule}`}>
        <div>
          <p class={`text-[13px] font-semibold ${c.head}`}>Índice documental</p>
          <p class={`text-[10px] ${c.muted}`}>Última sincronización hace 4 min</p>
        </div>
        <div class="flex items-center gap-2">
          <div class={`hidden rounded-md border p-0.5 sm:flex ${c.rule}`}>
            {['7d', '30d', '90d'].map((r, i) => (
              <span class={`rounded px-2 py-1 text-[10px] ${i === 1 ? `${c.raised} ${c.head}` : c.muted}`}>{r}</span>
            ))}
          </div>
          <span class={`grid h-7 w-7 place-items-center rounded-full text-[10px] font-semibold ${c.raised} ${c.body}`}>AT</span>
        </div>
      </div>

      <!-- kpis -->
      <div class={`grid divide-y border-b sm:grid-cols-3 sm:divide-x sm:divide-y-0 ${c.divide} ${c.rule}`}>
        {kpis.map((k, i) => (
          <div class="px-5 py-4">
            <p class={`text-[10px] tracking-wide uppercase ${c.muted}`}>{k.label}</p>
            <div class="mt-1.5 flex items-baseline gap-2">
              <span
                class={`font-display text-xl font-semibold ${c.head}`}
                data-count={k.value}
                data-decimals={k.decimals}
                data-suffix={k.suffix}
                style={`--d:${i * 120}ms`}>0</span>
              <span class={`text-[10px] ${c.muted}`}>{k.delta}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- gráfico -->
      <div class="px-5 pt-5">
        <div class="flex items-center justify-between">
          <p class={`text-[11px] font-medium ${c.head}`}>Preguntas de los empleados</p>
          <div class="flex items-center gap-3">
            <span class={`flex items-center gap-1.5 text-[10px] ${c.muted}`}>
              <span class={`h-1.5 w-1.5 rounded-full ${c.fill}`}></span>consultas
            </span>
            <span class={`flex items-center gap-1.5 text-[10px] ${c.muted}`}>
              <span class={`h-1.5 w-1.5 rounded-full ${c.fillSoft}`}></span>caché
            </span>
          </div>
        </div>

        <svg viewBox={`0 0 ${W} ${H + 16}`} class="mt-3 w-full" preserveAspectRatio="none" style="height:120px">
          <defs>
            <linearGradient id={gradId} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color={c.areaTop} />
              <stop offset="100%" stop-color={c.areaBottom} />
            </linearGradient>
          </defs>
          {[0, 1, 2, 3].map((i) => (
            <line x1="0" x2={W} y1={22 + i * ((H - 22) / 3)} y2={22 + i * ((H - 22) / 3)} stroke={c.grid} stroke-width="1" />
          ))}
          <path d={area} fill={`url(#${gradId})`} data-fade style="--d:900ms" />
          <path
            d={line}
            fill="none"
            stroke={c.stroke}
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            data-draw
            style="--len:900"
          />
          <circle cx={pts[pts.length - 1][0] - 3} cy={pts[pts.length - 1][1]} r="3.5" fill={c.stroke} data-fade style="--d:1800ms" />
        </svg>
      </div>

      <!-- carpetas -->
      <div class="px-5 pt-4 pb-5">
        <div class={`grid grid-cols-[1fr_auto] items-center gap-3 border-b pb-2 text-[10px] tracking-wide uppercase sm:grid-cols-[.7fr_1.3fr_.5fr_.5fr] ${c.rule} ${c.muted}`}>
          <span>Origen</span>
          <span class="hidden sm:block">Carpeta indexada</span>
          <span class="hidden sm:block">Estado</span>
          <span class="text-right">Docs</span>
        </div>
        {folders.map((f) => (
          <div
            class={`grid grid-cols-[1fr_auto] items-center gap-3 border-b py-2.5 text-[11px] last:border-0 sm:grid-cols-[.7fr_1.3fr_.5fr_.5fr] ${c.rule}`}
          >
            <span class={`flex items-center gap-2 ${c.body}`}>
              <span class={`h-1.5 w-1.5 shrink-0 rounded-full ${f.state === 'OK' ? c.fill : c.fillSoft}`}></span>
              {f.src}
            </span>
            <span class={`hidden truncate font-mono sm:block ${c.muted}`}>{f.path}</span>
            <span class="hidden sm:block">
              <span class={`rounded border px-1.5 py-0.5 font-mono text-[9px] ${c.chip}`}>{f.state}</span>
            </span>
            <span class={`text-right font-mono ${c.body}`}>{f.docs}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</WindowFrame>
