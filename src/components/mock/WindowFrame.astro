---
import { tone, type Tone } from '../../lib/tone';

interface Props {
  variant?: Tone;
  label?: string;
  class?: string;
  rounded?: string;
}

const { variant = 'dark', label = 'console.in2ai.com', class: cls = '', rounded = 'rounded-2xl' } = Astro.props;
const c = tone(variant);
---

<div class={`overflow-hidden border ${rounded} ${c.shell} ${c.shadow} ${cls}`}>
  <div class={`flex items-center gap-3 border-b px-4 py-3 ${c.chrome}`}>
    <div class="flex gap-1.5">
      <span class={`h-2.5 w-2.5 rounded-full ${c.dot}`}></span>
      <span class={`h-2.5 w-2.5 rounded-full ${c.dot}`}></span>
      <span class={`h-2.5 w-2.5 rounded-full ${c.dot}`}></span>
    </div>
    <div class={`mx-auto flex items-center gap-2 rounded-md border px-3 py-1 ${c.chip}`}>
      <svg class="h-3 w-3 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="4" y="10" width="16" height="10" rx="2" />
        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
      </svg>
      <span class="font-mono text-[10px] tracking-tight">{label}</span>
    </div>
    <div class="flex gap-1.5 opacity-40">
      <span class={`h-2.5 w-4 rounded-sm ${c.dot}`}></span>
    </div>
  </div>
  <slot />
</div>
