---
import { tone, type Tone } from '../../lib/tone';

interface Props {
  variant?: Tone;
  class?: string;
}

const { variant = 'dark', class: cls = '' } = Astro.props;
const c = tone(variant);

const sources = ['OneDrive', 'Google Drive', 'Dropbox', 'SharePoint'];
const citations = ['PRL-014_altura.pdf · p. 7', 'Convenio_2026.docx · art. 12', 'Checklist_obra.xlsx'];
---

<div class={`overflow-hidden rounded-2xl border ${c.shell} ${c.shadow} ${cls}`}>
  <!-- cabecera -->
  <div class={`border-b ${c.chrome}`}>
    <div class="flex items-center justify-between px-4 py-3">
      <div class="flex items-center gap-2.5">
        <span class={`grid h-7 w-7 place-items-center rounded-lg ${c.fill}`}>
          <span class={`font-display text-[10px] font-bold ${variant === 'dark' ? 'text-black' : 'text-white'}`}>A2</span>
        </span>
        <div>
          <p class={`text-[12px] font-semibold ${c.head}`}>ASM2 · Asistente documental</p>
          <p class={`flex items-center gap-1.5 text-[10px] ${c.muted}`}>
            <span class="relative flex h-1.5 w-1.5">
              <span class={`absolute inline-flex h-full w-full animate-ping rounded-full opacity-70 ${c.fill}`}></span>
              <span class={`relative inline-flex h-1.5 w-1.5 rounded-full ${c.fill}`}></span>
            </span>
            4 carpetas indexadas · 48.312 documentos
          </p>
        </div>
      </div>
      <span class={`hidden rounded border px-2 py-1 font-mono text-[9px] tracking-wider uppercase sm:block ${c.chip}`}>
        on-premise
      </span>
    </div>

    <!-- conectores -->
    <div class={`flex items-center gap-1.5 overflow-hidden border-t px-4 py-2 ${c.rule}`}>
      <span class={`font-mono text-[9px] tracking-wider uppercase ${c.muted}`}>Fuentes</span>
      {sources.map((s) => (
        <span class={`rounded border px-1.5 py-0.5 font-mono text-[9px] whitespace-nowrap ${c.chip}`}>{s}</span>
      ))}
    </div>
  </div>

  <!-- hilo -->
  <div class={`space-y-3.5 p-4 ${c.panel}`}>
    <div class="flex justify-end">
      <p class={`max-w-[82%] rounded-2xl rounded-br-sm px-3.5 py-2.5 text-[12px] leading-relaxed ${c.bubbleUser}`}>
        ¿Qué EPIs son obligatorios para trabajos en altura según nuestro procedimiento?
      </p>
    </div>

    <!-- recuperación -->
    <div class={`rounded-xl border px-3 py-2.5 font-mono text-[10px] leading-relaxed ${c.rule} ${c.sub}`}>
      <p class={c.muted}>↳ buscar_indice(carpetas=["/Calidad/Procedimientos"], top_k=6)</p>
      <p class={c.muted}>↳ filtrar_permisos(usuario="a.torres@cliente.com")</p>
      <p class={`mt-1 flex items-center gap-1.5 ${c.body}`}>
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 13 4 4L19 7" stroke-linecap="round" /></svg>
        6 fragmentos · 3 documentos · 480 ms
      </p>
    </div>

    <div class="flex justify-start">
      <div class={`max-w-[90%] rounded-2xl rounded-bl-sm px-3.5 py-3 text-[12px] leading-relaxed ${c.bubbleBot}`}>
        <p>
          Para trabajos por encima de 2 m el procedimiento exige
          <span class={`rounded px-1 font-medium ${c.mark}`}>arnés con doble cabo de anclaje</span>, casco con barboquejo y
          línea de vida homologada. La formación específica caduca a los 3 años.
        </p>
        <div class={`mt-3 flex flex-wrap gap-1.5 border-t pt-2.5 ${c.rule}`}>
          {citations.map((s) => (
            <span class={`inline-flex items-center gap-1 rounded border px-1.5 py-0.5 font-mono text-[9px] ${c.chip}`}>
              <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 3v5h5M7 3h8l5 5v13H7z" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {s}
            </span>
          ))}
        </div>
      </div>
    </div>

    <div class="flex items-center gap-1.5 pl-1">
      <span class={`dot-1 h-1.5 w-1.5 rounded-full ${c.fillSoft}`}></span>
      <span class={`dot-2 h-1.5 w-1.5 rounded-full ${c.fillSoft}`}></span>
      <span class={`dot-3 h-1.5 w-1.5 rounded-full ${c.fillSoft}`}></span>
      <span class={`ml-1 text-[10px] ${c.muted}`}>buscando el anexo de formación…</span>
    </div>
  </div>

  <!-- entrada -->
  <div class={`border-t ${c.rule} ${c.sub}`}>
    <div class="flex items-center gap-2 px-4 py-3">
      <div class={`flex flex-1 items-center rounded-lg border px-3 py-2 ${c.rule} ${c.panel}`}>
        <span class={`caret text-[11px] ${c.muted}`}>¿Y para espacios confinados?</span>
      </div>
      <button class={`grid h-8 w-8 shrink-0 place-items-center rounded-lg ${c.fill}`} aria-label="Enviar">
        <svg class={`h-4 w-4 ${variant === 'dark' ? 'text-black' : 'text-white'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 19V5m-7 7 7-7 7 7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
    <p class={`flex items-center gap-1.5 border-t px-4 py-2 font-mono text-[9px] ${c.rule} ${c.muted}`}>
      <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="4" y="10" width="16" height="10" rx="2" />
        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
      </svg>
      Responde solo con documentos que este usuario puede ver · nada sale de tu red
    </p>
  </div>
</div>
