---
import Rich from './Rich.astro';
import BlogCard from './BlogCard.astro';
import { getLocale, useTranslations } from '../i18n';
import { blogPosts, findPage } from '../lib/website';
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const teamPath = locale === 'es' ? '/nuestroequipo/' : '/en/ourteam/';
const researchPath = locale === 'es' ? '/investigacion-desarrollo/' : '/en/rd/';
const members = findPage(teamPath)?.team.slice(0, 4) ?? [];
---

<section class="bg-brand-mist">
  <div class="mx-auto max-w-[86rem] px-6 py-24 md:px-10 md:py-32">
    <div class="grid gap-14 lg:grid-cols-2 lg:items-center lg:gap-20">
      <div data-reveal="left">
        <p class="text-[11px] font-semibold tracking-[0.2em] text-brand-blue-deep uppercase">{t.about.eyebrow}</p>
        <h2 class="mt-6 font-display text-[clamp(2.4rem,5.5vw,4.4rem)] leading-[0.98] font-bold tracking-[-0.04em]"><Rich text={t.about.title} outline="--outline-w:1.5px" /></h2>
        <p class="mt-8 max-w-lg text-lg leading-relaxed text-brand-ink/70">{t.about.text}</p>
        <a href={teamPath} class="link-sweep mt-8 inline-block text-sm font-semibold text-brand-blue-deep">{t.about.team} →</a>
      </div>
      <ul class="grid grid-cols-2 gap-4 sm:gap-6" data-reveal="right">
        {members.map((member) => <li>
          <a href={teamPath} class="group block">
            <img src={member.image} alt={member.name} width="400" height="400" loading="lazy" class="aspect-square w-full rounded-2xl object-cover object-top transition duration-500 group-hover:brightness-105" />
            <p class="mt-3 font-display text-sm font-bold sm:text-base">{member.name}</p>
            <p class="mt-1 text-xs text-brand-slate-deep">{member.role}</p>
          </a>
        </li>)}
      </ul>
    </div>
    <div class="mt-16 grid gap-6 rounded-3xl border border-brand-blue/20 bg-white p-7 sm:p-10 lg:grid-cols-[0.8fr_1.2fr]" data-reveal>
      <h3 class="font-display text-2xl font-bold tracking-tight text-brand-blue-deep">{t.about.research}</h3>
      <div>
        <p class="max-w-2xl leading-relaxed text-brand-ink/70">{t.about.researchText}</p>
        <p class="mt-5 font-mono text-xs tracking-wide text-brand-blue-deep">{locale === 'es' ? 'ASM2 · PORPRI-ML · IDADEV-P2P' : 'PORPRI-ML · IDADEV-P2P'}</p>
        <a href={researchPath} class="link-sweep mt-6 inline-block text-sm font-semibold">{t.services.more} →</a>
      </div>
    </div>
  </div>
</section>

<section class="bg-white">
  <div class="mx-auto max-w-[86rem] px-6 py-24 md:px-10 md:py-32">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <div>
        <p class="text-[11px] font-semibold tracking-[0.2em] text-brand-blue-deep uppercase">{t.news.eyebrow}</p>
        <h2 class="mt-6 font-display text-[clamp(2.4rem,5.5vw,4.4rem)] leading-[0.98] font-bold tracking-[-0.04em]"><Rich text={t.news.title} outline="--outline-w:1.5px" /></h2>
      </div>
      <a href="/blog/" hreflang="es" class="link-sweep self-start text-sm font-semibold text-brand-blue-deep sm:self-auto">{t.news.all} →</a>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {blogPosts.slice(0, 3).map((post, i) => <div data-reveal style={`--d:${i * 100}ms`}><BlogCard post={post} /></div>)}
    </div>
  </div>
</section>
