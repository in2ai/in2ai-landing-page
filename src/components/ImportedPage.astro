---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import ContactForm from './ContactForm.astro';
import Forecast from './mock/Forecast.astro';
import NeuralNet from './mock/NeuralNet.astro';
import SolarPanel from './mock/SolarPanel.astro';
import DocPanel from './mock/DocPanel.astro';
import ChatPanel from './mock/ChatPanel.astro';
import { getLocale, htmlLang, useTranslations } from '../i18n';
import type { ImportedPage } from '../lib/website';
import sectorContent from '../data/sector-content.json';
import '../styles/imported.css';

interface Props { page: ImportedPage }
const { page } = Astro.props;
const locale = getLocale(page.locale);
const t = useTranslations(locale);
const home = getRelativeLocaleUrl(locale, '');
const isContact = page.path === '/contacto/' || page.path === '/en/contact/';
const isTeam = page.team.length > 0;
// páginas de sector: «Principales soluciones» como un tablero de ventanas flotantes, todas a la vista y un poco desordenadas
const isSector = page.path in sectorContent;
const tilt = [-1.6, 1.1, -0.8, 1.5, 1, -1.3, 0.7];
const lift = [0, 0.9, 0.25, 1.1, 0.6, 0, 1];
const accent = ['cyan', 'blue', 'clay', 'slate'];
const board = (items: string) =>
  [...items.matchAll(/<h4>([\s\S]*?)<\/h4>\s*<p>([\s\S]*?)<\/p>/g)]
    .map(
      ([, title, text], i) =>
        `<div class="solution" data-reveal="scale" style="--d:${i * 90}ms"><article class="solution-card" data-accent="${accent[i % accent.length]}" style="--r:${tilt[i % tilt.length]}deg;--y:${lift[i % lift.length]}rem;--f:${7 + (i % 4) * 1.5}s"><div class="solution-bar" aria-hidden="true"><span></span><span></span><span></span></div><div class="solution-body"><h4>${title}</h4><p>${text}</p></div></article></div>`,
    )
    .join('');
const withBoard = isSector
  ? page.html.replace(
      /<section class="import-section">(<h2[^>]*>[\s\S]*?<\/h2>)((?:\s*<i><\/i>\s*<h4>[\s\S]*?<\/h4>\s*<p>[\s\S]*?<\/p>)+)\s*<\/section>/,
      (_, heading, items) => `<section class="import-section solutions">${heading}<div class="solutions-board">${board(items)}</div></section>`,
    )
  : page.html;
// páginas de servicio (Data Driven, Machine Learning…): una escena animada junto a la introducción y los pasos como tarjetas
const serviceVisual: Record<string, 'data' | 'ml' | 'vision' | 'nlp' | 'genai'> = {
  '/data-driven/': 'data',
  '/en/data-driven/': 'data',
  '/machine-learning/': 'ml',
  '/en/machine-learning/': 'ml',
  '/vision-artificial/': 'vision',
  '/en/artificial-vision/': 'vision',
  '/procesamiento-lenguaje-natural/': 'nlp',
  '/en/natural-language-processing-nlp/': 'nlp',
  '/ia-generativa/': 'genai',
  '/en/generative-artificial-intelligence/': 'genai',
};
const visual = serviceVisual[page.path];
const isService = Boolean(visual);
const compact = isSector || isService;
const stepIcons = [
  'M4 20h16M6 20V10m5 10V4m5 16V8m5 12v-6',
  'M4 6c0-1.1 3.6-2 8-2s8 .9 8 2-3.6 2-8 2-8-.9-8-2Zm0 6c0 1.1 3.6 2 8 2s8-.9 8-2M4 6v12c0 1.1 3.6 2 8 2s8-.9 8-2V6',
  'M13 3 5 14h6l-1 7 8-11h-6l1-7Z',
  'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-5a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z',
  'm12 3 9 5-9 5-9-5 9-5ZM3 12l9 5 9-5M3 16l9 5 9-5',
  'M3 17l6-6 4 4 8-8M15 7h6v6',
  'M12 3l8 3v6c0 5-3.4 8-8 9-4.6-1-8-4-8-9V6l8-3Z',
  'M4 5h16v10H9l-5 4V5Z',
];
interface Group { title?: string; items: string[] }
const stepCard = (body: string, i: number) => {
  const head = body.match(/^\s*<(h2|h3)[^>]*>([\s\S]*?)<\/\1>/);
  const rest = head ? body.slice(head[0].length) : body;
  const cut = rest.search(/<(ul|ol|h3)\b/);
  const lead = (cut === -1 ? rest : rest.slice(0, cut)).trim();
  const groups: Group[] = [];
  let current: Group | null = null;
  for (const m of (cut === -1 ? '' : rest.slice(cut)).matchAll(/<h3[^>]*>([\s\S]*?)<\/h3>|<li[^>]*>([\s\S]*?)<\/li>/g)) {
    if (m[1] !== undefined) {
      current = { title: m[1], items: [] };
      groups.push(current);
    } else {
      if (!current) {
        current = { items: [] };
        groups.push(current);
      }
      current.items.push(m[2]);
    }
  }
  const groupsHtml = groups.length
    ? `<div class="step-groups">${groups
        .map((g) => `<div class="step-group">${g.title ? `<h3>${g.title}</h3>` : ''}<ul class="step-points">${g.items.map((li) => `<li>${li}</li>`).join('')}</ul></div>`)
        .join('')}</div>`
    : '';
  return `<div class="step${groups.length > 1 ? ' step-wide' : ''}" data-reveal="scale" style="--d:${(i % 3) * 90}ms"><article class="step-card" data-accent="${accent[i % accent.length]}"><span class="step-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="${stepIcons[i % stepIcons.length]}"/></svg></span><h2>${head ? head[2] : ''}</h2><div class="step-lead">${lead}</div>${groupsHtml}</article></div>`;
};
let serviceIntro = '';
let serviceSteps = '';
let serviceCta = '';
if (isService) {
  const sections = [...page.html.matchAll(/<section class="import-section">([\s\S]*?)<\/section>/g)].map((m) => m[1]);
  serviceIntro = sections[0] ?? '';
  let n = 0;
  for (const body of sections.slice(1)) {
    if (/href="\/(?:en\/)?contact/.test(body)) serviceCta = body.replace('Nos gustas los', 'Nos gustan los');
    else if (/^\s*<h[23]/.test(body)) serviceSteps += stepCard(body, n++);
    else serviceSteps += `<div class="step step-wide"><div class="step-lead">${body}</div></div>`;
  }
}
// proyectos de I+D+i (logo, título y texto, tira de logos): el texto manda y el logo va pequeño a la derecha
const html = withBoard.replace(
  /<section class="import-section">\s*(<img[^>]*>)\s*(<h3(?:(?!<img)[\s\S])*?)\s*(<img[^>]*>)\s*<\/section>/g,
  (_, media, body, logos) =>
    `<section class="import-section project"><div class="project-body">${body}</div><div class="project-media">${media}</div><div class="project-logos">${logos}</div></section>`,
);
const date = new Intl.DateTimeFormat(htmlLang[locale], { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(page.date));
---

<Base title={`${page.title} | In2AI`} description={page.description} alternatePages={page.alternates} image={page.image} bodyClass="bg-white font-sans text-brand-ink antialiased" progressClass="bg-brand-cyan">
  <SiteHeader alternatePages={page.alternates} />
  <main>
    <section class="bg-brand-mist">
      <div class:list={['mx-auto max-w-[86rem] px-6 md:px-10', compact ? 'py-10 md:py-12' : 'py-16 md:py-24']}>
        <a href={page.kind === 'post' ? '/blog/' : home} class="text-sm font-medium text-brand-blue-deep underline underline-offset-4">
          ← {page.kind === 'post' ? 'Blog' : 'In2AI'}
        </a>
        <h1 class:list={['max-w-5xl font-display leading-[1.05] font-bold tracking-[-0.04em]', compact ? 'mt-5 text-[clamp(2rem,3.6vw,3.25rem)]' : 'mt-8 text-[clamp(2.4rem,5.5vw,5rem)]']}>{page.title}</h1>
        {page.kind === 'post' && <p class="mt-6 text-sm text-brand-slate-deep"><time datetime={page.date}>{date}</time> · {page.author}</p>}
      </div>
    </section>
    <article class:list={['mx-auto px-6 md:px-10', compact ? 'py-10 md:py-14' : 'py-16 md:py-24', isTeam || compact ? 'max-w-6xl' : 'max-w-4xl']}>
      {page.image && <img src={page.image} alt="" class="mb-12 max-h-[32rem] w-full rounded-2xl object-contain" fetchpriority="high" />}
      {isService ? (
        <>
          <div class="service-hero">
            <div class="service-visual">
              {visual === 'data' && <Forecast variant="brand" />}
              {visual === 'ml' && <NeuralNet />}
              {visual === 'vision' && <SolarPanel variant="brand" />}
              {visual === 'nlp' && <DocPanel variant="brand" />}
              {visual === 'genai' && <ChatPanel variant="brand" />}
            </div>
            <div class="import-content service-intro" set:html={serviceIntro} />
          </div>
          <div class="import-content service-steps">
            <div class:list={['steps-grid', visual === 'genai' && 'steps-stack']} set:html={serviceSteps} />
            {serviceCta && <section class="service-cta" set:html={serviceCta} />}
          </div>
        </>
      ) : (
        <div class:list={['import-content', isSector && 'has-board']} set:html={html} />
      )}
      {isContact && <div class="mt-12 rounded-3xl bg-brand-ink p-2 sm:p-4"><ContactForm /></div>}
    </article>
    {!isContact && <section class="bg-brand-sky px-6 py-16 md:px-10">
      <div class="mx-auto flex max-w-6xl flex-col gap-8 sm:flex-row sm:items-center sm:justify-between">
        <div><h2 class="font-display text-3xl font-bold tracking-tight">{t.header.contact}</h2><p class="mt-3 max-w-xl leading-relaxed">{t.contact.text}</p></div>
        <a href={`${home}#${t.anchors.contact}`} class="inline-flex shrink-0 items-center justify-center rounded-full bg-brand-ink px-7 py-4 text-sm font-semibold text-white">{t.hero.cta} →</a>
      </div>
    </section>}
  </main>
  <SiteFooter />
</Base>
