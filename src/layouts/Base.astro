---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import { defaultLocale, getLocale, htmlLang, locales, useTranslations } from '../i18n';
import type { AlternatePage } from '../lib/website';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  /** Tailwind classes for the reading-progress bar. Empty string hides it. */
  progressClass?: string;
  themeColor?: string;
  alternatePages?: AlternatePage[];
  image?: string;
}

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const {
  title,
  description = t.meta.description,
  bodyClass = '',
  progressClass = 'bg-black',
  themeColor = '#ffffff',
  alternatePages,
  image,
} = Astro.props;

// la misma página en cada idioma: se quita el prefijo del idioma actual (/en) y se
// vuelve a montar la ruta para cada uno, para las etiquetas hreflang
const prefix = locale === defaultLocale ? '' : `/${locale}`;
const path = Astro.url.pathname.slice(prefix.length).replace(/^\//, '');
const canonical = getAbsoluteLocaleUrl(locale, path);
const alternates = alternatePages
  ? alternatePages.map((page) => ({ hreflang: page.locale, href: new URL(page.path, Astro.site).href }))
  : locales.map((l) => ({ hreflang: l, href: getAbsoluteLocaleUrl(l, path) }));
const defaultAlternate = alternates.find((alt) => alt.hreflang === defaultLocale) ?? alternates[0];
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={themeColor} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
    {
      locales
        .filter((l) => l !== locale && alternates.some((alt) => alt.hreflang === l))
        .map((l) => <meta property="og:locale:alternate" content={useTranslations(l).meta.ogLocale} />)
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body class={bodyClass}>
    {progressClass && <div id="progress" class={progressClass}></div>}
    <slot />

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ── animated counters ───────────────────────────────────────────────
      function runCounter(el: HTMLElement) {
        if (el.dataset.counted) return;
        el.dataset.counted = '1';

        const raw = el.dataset.count ?? '0';
        const target = parseFloat(raw);
        const decimals = Number(el.dataset.decimals ?? (raw.includes('.') ? 1 : 0));
        const prefix = el.dataset.prefix ?? '';
        const suffix = el.dataset.suffix ?? '';
        // el idioma de la página decide el formato: 2,9 y 9.480 en español, 2.9 y 9,480 en inglés
        const fmt = new Intl.NumberFormat(document.documentElement.lang || 'es-ES', {
          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals,
          // es-ES omite el punto en números de 4 cifras; lo forzamos para que
          // 1.284 y 9.480 casen con los valores de las tablas de los mockups.
          useGrouping: 'always',
        });
        const paint = (v: number) => (el.textContent = prefix + fmt.format(v) + suffix);

        if (reduce) return paint(target);

        const duration = 1500;
        const start = performance.now();
        const tick = (now: number) => {
          const p = Math.min(1, (now - start) / duration);
          paint(target * (1 - Math.pow(1 - p, 3)));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

      // ── reveal on scroll ────────────────────────────────────────────────
      const animated = [
        ...document.querySelectorAll<HTMLElement>(
          '[data-reveal],[data-bar],[data-draw],[data-fade],[data-grow],[data-count]',
        ),
      ];

      const activate = (el: HTMLElement) => {
        el.classList.add('is-in');
        if (el.dataset.count) runCounter(el);
      };

      if (reduce || !('IntersectionObserver' in window)) {
        animated.forEach(activate);
      } else {
        // Las barras y trazos arrancan con tamaño cero (width:0, scaleX(0)), así que
        // el observer nunca los detecta: observamos su contenedor y activamos el grupo.
        const groups = new Map<Element, Set<HTMLElement>>();

        for (const el of animated) {
          const zeroSized =
            el.hasAttribute('data-bar') || el.hasAttribute('data-draw') || el.hasAttribute('data-grow');
          const target = (zeroSized && el.parentElement) || el;
          if (!groups.has(target)) groups.set(target, new Set());
          groups.get(target)!.add(el);
        }

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              groups.get(entry.target)?.forEach(activate);
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.06 },
        );
        groups.forEach((_, target) => io.observe(target));
      }

      // ── reading progress ────────────────────────────────────────────────
      const progress = document.getElementById('progress');
      if (progress) {
        const paintProgress = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          progress.style.width = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
        };
        document.addEventListener('scroll', paintProgress, { passive: true });
        paintProgress();
      }

      // ── header state on scroll ──────────────────────────────────────────
      const header = document.querySelector('[data-header]');
      if (header) {
        const paintHeader = () => header.classList.toggle('is-scrolled', window.scrollY > 16);
        document.addEventListener('scroll', paintHeader, { passive: true });
        paintHeader();
      }

      // ── mobile menu ─────────────────────────────────────────────────────
      document.querySelectorAll<HTMLElement>('[data-menu-toggle]').forEach((btn) => {
        const panel = document.getElementById(btn.dataset.menuToggle ?? '');
        if (!panel) return;

        const setOpen = (open: boolean) => {
          panel.classList.toggle('hidden', !open);
          btn.setAttribute('aria-expanded', String(open));
          document.documentElement.style.overflow = open ? 'hidden' : '';
        };

        btn.addEventListener('click', () => setOpen(panel.classList.contains('hidden')));
        panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !panel.classList.contains('hidden')) setOpen(false);
        });
      });
    </script>
  </body>
</html>
